<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>desktolls</AssemblyName>
    <RootNamespace>DeskTolls</RootNamespace>
    <ApplicationIcon>Assets\desktolls.ico</ApplicationIcon>
    <Version>1.10.0</Version>
    <Authors>desktolls</Authors>
    <Description>Desktop utilities and a resilient multi-threaded file downloader.</Description>
  </PropertyGroup>
</Project>
